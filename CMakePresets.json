{
  "version": 3,
  "configurePresets": [
    {
      "name": "wsl-vcpkg-debug",
      "displayName": "WSL + vcpkg Debug",
      "binaryDir": "${sourceDir}/build",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "/opt/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ]
}
